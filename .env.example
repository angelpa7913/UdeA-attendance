# Copia este archivo a .env y completa los valores. Nunca subas .env al repositorio.
# SECURITY: los secretos viven solo en el servidor y en variables de entorno.

# Base de datos (PostgreSQL por defecto; cualquier motor con driver JDBC sirve)
DB_URL=jdbc:postgresql://localhost:5432/attendance
DB_USER=attendance
DB_PASSWORD=change-me

# Proveedor OIDC (Google, Microsoft, Keycloak...). Solo cambia estos valores para cambiar de proveedor.
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# Ejemplos: https://accounts.google.com | https://login.microsoftonline.com/<tenant>/v2.0 | https://<host>/realms/<realm>
OIDC_ISSUER_URI=https://accounts.google.com
